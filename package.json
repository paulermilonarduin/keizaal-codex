{
  "name": "keizaal-codex",
  "version": "0.1.1",
  "description": "Suivi des personnages rencontrés sur le serveur RP Skyrim Keizaal",
  "author": "Paul Ermilon-Arduin",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/server.ts",
    "test": "vue-tsc --noEmit && node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "electron": "npm run build && electron .",
    "dist:electron": "npm run build && electron-builder"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-advanced-cropper": "^2.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.keizaal.codex",
    "productName": "Codex Keizaal",
    "asar": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    }
  }
}
